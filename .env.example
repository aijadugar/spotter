# Spotter environment variables
# Copy this file to .env and fill in your values

# ElevenLabs voice coach (optional)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
SPOTTER_TTS_LANGUAGE=en
SPOTTER_TTS_MAX_CHARS_PER_RUN=600
SPOTTER_TTS_BACKEND=elevenlabs

# Coach summary provider (optional)
SPOTTER_COACH_SUMMARY_PROVIDER=hf_inference
SPOTTER_COACH_SUMMARY_MODEL=aijadugar/spotter-coach-summary1

# Mock mode for testing
SPOTTER_MOCK_MODE=0

# Pose backend
SPOTTER_POSE_BACKEND=mediapipe